# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.dll
*.so
*.dylib

# Virtual environments
.venv/
venv/
env/
ENV/

# Databases & local journals (do not commit runtime DBs)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-journal

# Large weights and binaries (>50MB, cannot be committed directly to GitHub)
*.gguf
*.pte
*.zip
*.tar.gz
ecosort-board.tar.gz

# Allow exported models under models/
!models/*.onnx
!models/*.param
!models/*.bin
!models/*.pt

# Datasets and archives
waste.v28i.yolov11.zip
test C2S/*.zip
training_data/
waste-detection.v1i.yolov8/
P-yesist-v2/
test C2S/

# Logs and runtime artifacts
logs/*.log
*.log
_patch_tmp/
.pytest_cache/
.claude/

# Vivado and EDA build files
*.jou
*.str
*.gen/
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.xpr
vivado_project/
vivado_zedboard_project/

# OS specific files
.DS_Store
Thumbs.db
.tmp.driveupload/
*.tmp
