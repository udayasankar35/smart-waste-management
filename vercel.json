{
  "version": 2,
  "builds": [
    {
      "src": "cloud_demo/api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "cloud_demo/api/**",
          "web/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "cloud_demo/api/index.py"
    }
  ]
}
